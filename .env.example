# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=troque-isto
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=gere-com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=jobhunter.guilhermedorea.com,localhost,127.0.0.1
# localhost:3000 = Next dev server (cd web && npm run dev)
DJANGO_CSRF_TRUSTED_ORIGINS=https://jobhunter.guilhermedorea.com,http://localhost:8000,http://localhost:3000

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANALYSES_PER_DAY=10

# Optional: raises GitHub API limit from 60 to 5000 req/h
GITHUB_TOKEN=

# Cloudflare Zero Trust > Networks > Tunnels > token of the "jobhunter" tunnel
TUNNEL_TOKEN=

# Where daily pg_dump files go (ideally another disk), keeps the last 7
BACKUP_DIR=D:/jobhunter/backups
